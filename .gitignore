# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# registry
public/registry/*

# search index
public/search-index/*

# feed
src/feed

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temp (*minion*)
AGENTS.md
.claude*
.agents*
skills-lock.json

packages/cli-tool/dist
packages/cli-tool/node_modules
packages/cli-tool/test-project/src/components/*
!packages/cli-tool/test-project/src/components/.gitkeep
